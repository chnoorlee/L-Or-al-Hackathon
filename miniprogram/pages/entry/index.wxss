.entry-page { display: flex; flex-direction: column; padding-top: 24rpx; }
.entry-page .studio-masthead { padding-bottom: 28rpx; }
.wordmark-dot { color: var(--accent); }
.entry-hero { position: relative; min-height: 370rpx; background: var(--accent-soft); border-radius: 32rpx; overflow: hidden; }
.hero-copy { position: relative; z-index: 1; width: 61%; padding: 32rpx 0 38rpx 28rpx; }
.hero-eyebrow { display: block; color: var(--accent); font-size: max(12px, calc(22rpx + .5rem - 8px)); letter-spacing: 2rpx; }
.hero-title { display: block; margin-top: 30rpx; font-size: calc(42rpx + .5rem - 8px); font-weight: 500; line-height: 1.5; letter-spacing: -1rpx; }
.hero-title > text, .hero-description > text { display: block; }
.hero-description { display: block; margin-top: 20rpx; font-size: max(12px, calc(23rpx + .5rem - 8px)); line-height: 1.75; color: var(--muted); }
.hero-art { position: absolute; width: 48%; height: 94%; top: 0; right: -6rpx; }
.hero-art-label { position: absolute; right: 22rpx; bottom: 18rpx; font-size: max(10px,20rpx); color: var(--muted); }
.entry-live { padding: 28rpx 0 24rpx; }
.entry-live__heading, .photo-entry-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10rpx; }
.entry-section-title { font-size: calc(28rpx + .5rem - 8px); font-weight: 600; line-height: 1.5; }
.live-pill { display: flex; align-items: center; gap: 8rpx; border: 1rpx solid #d9c4d2; border-radius: 50rpx; padding: 6rpx 14rpx; color: var(--accent); font-size: max(12px,22rpx); }
.live-pill__dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--accent); }
.entry-description { display: block; margin: 10rpx 0 20rpx; color: var(--muted); font-size: max(12px,calc(24rpx + .5rem - 8px)); line-height: 1.65; }
.live-entry-button { gap: 16rpx; padding: 22rpx 28rpx; }
.live-entry-button .button-arrow { margin-left: auto; font-size: 36rpx; }
.mirror-icon { display: block; width: 32rpx; height: 40rpx; border: 2rpx solid currentColor; border-radius: 45%; flex: none; position: relative; margin-right: 4rpx; }
.mirror-icon::after { content: ''; position: absolute; height: 8rpx; width: 2rpx; left: 13rpx; bottom: -8rpx; background: currentColor; }
.photo-entry-heading { margin-top: 6rpx; }
.entry-mini-label { color: var(--muted); font-size: max(12px,22rpx); }
.entry-actions { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; margin-top: 18rpx; }
.entry-page .photo-entry { flex-direction: row; gap: 12rpx; padding: 24rpx 8rpx; min-width: 0; border-color: var(--line); font-size: calc(26rpx + .5rem - 8px); }
.camera-icon, .album-icon { display: block; position: relative; flex: none; width: 30rpx; height: 24rpx; border: 2rpx solid var(--accent); border-radius: 5rpx; }
.camera-icon::before { content: ''; position: absolute; width: 12rpx; height: 5rpx; top: -7rpx; left: 7rpx; border: 2rpx solid var(--accent); border-bottom: 0; border-radius: 3rpx 3rpx 0 0; }
.camera-icon::after { content: ''; position: absolute; width: 9rpx; height: 9rpx; top: 5rpx; left: 8rpx; border: 2rpx solid var(--accent); border-radius: 50%; }
.album-icon { height: 28rpx; }
.album-icon::after { content: ''; position: absolute; width: 13rpx; height: 13rpx; left: 5rpx; bottom: 1rpx; border-left: 2rpx solid var(--accent); border-top: 2rpx solid var(--accent); transform: rotate(45deg); }
.camera-entry-note { display: block; margin-top: 14rpx; font-size: max(12px,calc(21rpx + .5rem - 8px)); color: var(--muted); line-height: 1.6; }
.entry-guide { margin-top: 30rpx; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.guide-toggle { width: 100%; min-height: 72px; padding: 22rpx 0; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: transparent; text-align: left; color: var(--ink); line-height: 1.5; border-radius: 0; }
.guide-title, .guide-subtitle { display: block; }
.guide-title { font-size: calc(26rpx + .5rem - 8px); font-weight: 600; }
.guide-subtitle { color: var(--muted); font-size: max(12px,calc(22rpx + .5rem - 8px)); margin-top: 4rpx; }
.guide-plus { font-size: 32rpx; color: var(--accent); padding-right: 8rpx; }
.guide-content { padding-bottom: 24rpx; animation: page-reveal 200ms ease-out; }
.guide-step { display: flex; gap: 18rpx; padding: 16rpx 0; font-size: max(12px,calc(23rpx + .5rem - 8px)); line-height: 1.65; color: var(--muted); }
.guide-number { flex: none; color: var(--accent); font-family: Consolas,monospace; font-size: 24rpx; padding-top: 3rpx; }
.guide-step-title { display: block; color: var(--ink); font-weight: 600; margin-bottom: 4rpx; }
.guide-light { display: block; padding: 16rpx 18rpx; border-radius: 16rpx; background: var(--accent-soft); color: var(--muted); font-size: max(12px,calc(22rpx + .5rem - 8px)); line-height: 1.7; }
.privacy-note { margin-top: 24rpx; color: var(--muted); font-size: max(12px,calc(22rpx + .5rem - 8px)); line-height: 1.8; }
.privacy-note > text { display: block; }
.privacy-note__title { color: var(--accent); font-weight: 600; }
.disclaimer { display: block; margin-top: 12rpx; color: var(--muted); font-size: max(12px,calc(21rpx + .5rem - 8px)); line-height: 1.7; }
.entry-page .studio-footer { margin-top: 24rpx; }
.busy-status { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; color: var(--accent); font-size: 24rpx; line-height: 1.6; }
.busy-status__mark { flex: none; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--accent); animation: status-pulse 900ms ease-in-out infinite alternate; }
.inline-action { min-height: 44px; margin: 8rpx 0 0; padding: 0; background: transparent; color: var(--accent); font-size: 26rpx; text-align: left; text-decoration: underline; }
.processing-canvas { position: fixed; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.dialog-backdrop { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; overflow-y: auto; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); background: rgba(41,35,50,.48); }
.privacy-dialog { width: 100%; max-height: calc(100vh - 48rpx - env(safe-area-inset-bottom)); overflow-y: auto; padding: 36rpx 30rpx 18rpx; border-radius: 32rpx; background: var(--surface); }
.privacy-dialog__title { display: block; font-size: calc(34rpx + .5rem - 8px); line-height: 1.5; font-weight: 600; }
.privacy-dialog__body { display: block; margin: 20rpx 0 30rpx; color: var(--muted); font-size: calc(26rpx + .5rem - 8px); line-height: 1.8; }
.privacy-dialog__cancel { width: 100%; margin-top: 8rpx; }
.entry-page .primary-button, .dialog-backdrop .primary-button, .dialog-backdrop .text-button { font-size: calc(28rpx + .5rem - 8px); line-height: 1.5; padding-top: 20rpx; padding-bottom: 20rpx; white-space: normal; }
@media (max-width: 360px) { .entry-page .photo-entry { flex-direction: column; gap: 18rpx; } .hero-copy { width: 65%; padding-left: 22rpx; } .hero-title { font-size: calc(40rpx + .5rem - 8px); } }
