<page-meta root-font-size="system" />
<view class="mirror-page {{trackingMode === 'face' && hasFrame ? 'mirror-page--face' : ''}}">
  <view class="mirror-header"><button class="mirror-back" bindtap="onBack" aria-label="返回上一页">‹</button><text class="mirror-wordmark">EVEN TONE.</text><text class="mirror-caption">实时试妆镜</text></view>
  <view class="tracking-tabs"><button class="tracking-tab {{trackingMode === 'face' ? 'is-selected' : ''}}" data-value="face" bindtap="onTrackingMode" aria-pressed="{{trackingMode === 'face'}}">人脸试妆</button><button class="tracking-tab {{trackingMode === 'region' ? 'is-selected' : ''}}" data-value="region" bindtap="onTrackingMode" aria-pressed="{{trackingMode === 'region'}}">局部遮瑕</button></view>
  <view class="mirror-viewport">
    <view wx:if="{{hasFrame}}" class="mirror-badges"><view class="preview-label">{{phase === 'sampleA' || phase === 'sampleB' || phase === 'review' ? '定格圈选' : 'LIVE'}}</view><button class="mirror-flip" bindtap="onFlip" aria-label="切换前后镜头">翻转镜头</button></view>
    <view class="preview-stage live-stage" style="height: {{canvasHeight}}px; width: {{canvasWidth ? canvasWidth + 'px' : '100%'}}">
      <camera wx:if="{{cameraEnabled}}" id="liveCamera" data-generation="{{cameraGeneration}}" class="native-camera" device-position="{{devicePosition}}" flash="off" frame-size="medium" bindinitdone="onCameraReady" binderror="onCameraError" bindstop="onCameraStopped"/>
      <canvas id="liveCanvas" type="2d" class="preview-canvas {{gpu || !hasFrame ? 'canvas-inactive' : ''}}" style="height: {{canvasHeight}}px" bindtouchend="onSample" catchtouchmove="onSplitMove" aria-label="试妆镜，定格后点选待遮盖处与周边肤色"/>
      <canvas id="liveGLCanvas" type="webgl" class="preview-canvas {{!gpu || !hasFrame ? 'canvas-inactive' : ''}}" style="height: {{canvasHeight}}px" bindtouchend="onSample" catchtouchmove="onSplitMove" aria-label="试妆镜，左右拖动可调整分屏对比"/>
      <view wx:if="{{!hasFrame}}" class="camera-empty"><image class="mirror-illustration" src="/assets/tone-mirror.svg" mode="aspectFit" aria-hidden="true"/><view class="empty-title">把镜头，留给自己</view><view>{{trackingMode === 'face' ? '贴合面部，试试适合自己的肤色与妆感' : '圈选局部，探索喜欢的匀色妆效'}}</view><view class="empty-local">色彩概念插画 · 相机开启前不采集画面</view></view>
    </view>
    <view wx:if="{{phase === 'live' && mode === 'split' && !holdingOriginal}}" class="split-captions"><view>左侧 · 原图</view><view>右侧 · 模拟妆效</view></view>
    <view wx:if="{{phase === 'live' || (trackingMode === 'face' && hasFrame)}}" class="mirror-comparison"><button class="mirror-tool mirror-compare {{mode === 'split' ? 'is-active' : ''}}" disabled="{{phase !== 'live'}}" bindtap="onCompare" aria-pressed="{{mode === 'split'}}">{{mode === 'split' ? '退出分屏' : '分屏对比'}}</button><button class="mirror-tool" disabled="{{phase !== 'live'}}" bindtouchstart="onHoldOriginal" bindtouchend="onReleaseOriginal" bindtouchcancel="onReleaseOriginal" aria-label="按住查看原图，松开恢复妆效">{{holdingOriginal ? '正在查看原图' : '按住看原图'}}</button></view>
  </view>
  <view class="mirror-dock">
    <view class="live-status" aria-role="status" aria-live="polite"><text class="live-dot {{phase === 'live' ? 'live-dot--active' : ''}}"></text><text>{{status}}</text></view>
    <view wx:if="{{error}}" class="inline-error tracking-error" aria-role="alert"><text>{{error}}</text><view class="tracking-recovery"><button wx:if="{{trackingMode === 'face' && cameraEnabled && gpu}}" class="secondary-button" bindtap="onRetryFace">重试跟踪</button><button wx:if="{{trackingMode === 'face' && cameraEnabled}}" class="text-button" data-value="region" bindtap="onTrackingMode">改用局部遮瑕</button><button wx:else class="text-button" bindtap="onSettings">打开微信权限设置</button></view></view>
    <view wx:if="{{privacyVisible}}" class="inline-info"><text>相机画面在本机处理，不上传、不主动保存；退出即清除本次画面与选区。</text><button class="primary-button" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgreePrivacy">同意并开启相机</button><button class="text-button" bindtap="onCancelPrivacy">暂不开启</button></view>
    <button wx:elif="{{!cameraEnabled}}" class="primary-button" bindtap="onEnableCamera" disabled="{{cameraPending}}" loading="{{cameraPending}}" aria-busy="{{cameraPending}}">{{cameraPending ? '正在开启相机' : '开启我的试妆镜'}}</button>
    <view wx:elif="{{trackingMode === 'region' && (phase === 'view' || phase === 'lost')}}"><button class="primary-button" bindtap="onFreeze" disabled="{{!hasFrame}}">{{phase === 'lost' ? '重新圈选区域' : '圈选我的试妆区域'}}</button><text class="dock-hint">先点待遮盖处，再点周边肤色，自动生成轮廓。</text></view>
    <view wx:elif="{{phase === 'review'}}"><button class="primary-button" bindtap="onStartTracking">轮廓正确，试试妆效</button><button class="text-button" bindtap="onFreeze">重新圈选</button></view>
    <view wx:elif="{{phase === 'sampleA' || phase === 'sampleB'}}" class="calibration-steps"><text class="{{phase === 'sampleA' ? 'step-current' : ''}}">A · 待遮盖处</text><text class="{{phase === 'sampleB' ? 'step-current' : ''}}">B · 周边肤色</text><button class="text-button" bindtap="onResumeView">取消圈选</button></view>
    <view wx:if="{{phase === 'live' || (trackingMode === 'face' && cameraEnabled && hasFrame)}}" class="makeup-controls">
      <block wx:if="{{trackingMode === 'face'}}">
        <view class="category-list"><button class="category {{category === 'foundation' ? 'is-selected' : ''}}" data-value="foundation" bindtap="onCategory" aria-pressed="{{category === 'foundation'}}">底妆<text>{{look.foundation ? (phase === 'live' ? (holdingOriginal ? '已选择' : '已叠加') : '待显示') : '未使用'}}</text></button><button class="category {{category === 'lipstick' ? 'is-selected' : ''}}" data-value="lipstick" bindtap="onCategory" aria-pressed="{{category === 'lipstick'}}">唇色<text>{{look.lipstick ? (phase === 'live' ? (holdingOriginal ? '已选择' : '已叠加') : '待显示') : '未使用'}}</text></button><button class="category {{category === 'blush' ? 'is-selected' : ''}}" data-value="blush" bindtap="onCategory" aria-pressed="{{category === 'blush'}}">腮红<text>{{look.blush ? (phase === 'live' ? (holdingOriginal ? '已选择' : '已叠加') : '待显示') : '未使用'}}</text></button></view>
        <view class="layer-heading"><text>{{category === 'foundation' ? '轻轻匀色，保留肌肤纹理' : category === 'lipstick' ? '一点唇色，换一种心情' : '让好气色自然晕开'}}</text><button class="text-button" bindtap="onLayerToggle" aria-pressed="{{category === 'foundation' ? look.foundation : category === 'lipstick' ? look.lipstick : look.blush}}">{{(category === 'foundation' ? look.foundation : category === 'lipstick' ? look.lipstick : look.blush) ? '移除此层' : '叠加此层'}}</button></view>
      </block>
      <block wx:if="{{trackingMode === 'region' || category === 'foundation'}}">
      <view class="formula-list"><button class="formula {{formula === 'sheer' ? 'is-selected' : ''}}" data-value="sheer" bindtap="onFormula" aria-pressed="{{formula === 'sheer'}}">轻薄底妆</button><button class="formula {{formula === 'concealer' ? 'is-selected' : ''}}" data-value="concealer" bindtap="onFormula" aria-pressed="{{formula === 'concealer'}}">{{trackingMode === 'face' ? '匀色底妆' : '局部遮瑕'}}</button><button class="formula {{formula === 'soft' ? 'is-selected' : ''}}" data-value="soft" bindtap="onFormula" aria-pressed="{{formula === 'soft'}}">柔焦底妆</button></view>
      <view class="shade-heading"><text>{{trackingMode === 'face' ? '以镜头中的肤色为基准' : '以你的周边肤色为基准'}}</text><button class="text-button fine-toggle" bindtap="onFineTune" aria-expanded="{{fineTune}}">{{fineTune ? '收起微调' : '精细微调'}}</button></view>
      <view class="shade-list"><button class="shade {{shade === 'cool' ? 'is-selected' : ''}}" data-value="cool" bindtap="onShade" aria-pressed="{{shade === 'cool'}}"><text class="shade-chip shade-cool"></text><text>偏冷</text></button><button class="shade {{shade === 'match' ? 'is-selected' : ''}}" data-value="match" bindtap="onShade" aria-pressed="{{shade === 'match'}}"><text class="shade-chip shade-match"></text><text>贴近肤色</text></button><button class="shade {{shade === 'warm' ? 'is-selected' : ''}}" data-value="warm" bindtap="onShade" aria-pressed="{{shade === 'warm'}}"><text class="shade-chip shade-warm"></text><text>偏暖</text></button><button class="shade {{shade === 'lighter' ? 'is-selected' : ''}}" data-value="lighter" bindtap="onShade" aria-pressed="{{shade === 'lighter'}}"><text class="shade-chip shade-lighter"></text><text>浅一度</text></button><button class="shade {{shade === 'deeper' ? 'is-selected' : ''}}" data-value="deeper" bindtap="onShade" aria-pressed="{{shade === 'deeper'}}"><text class="shade-chip shade-deeper"></text><text>深一度</text></button></view>
      <view class="strength-row"><text>遮盖强度</text><slider value="{{strength}}" data-key="strength" bindchanging="onControl" bindchange="onControl" activeColor="#78475f" block-size="24" aria-label="实时遮盖强度"/><text>{{strength}}%</text></view>
      <view wx:if="{{fineTune}}" class="fine-panel"><view class="control-label"><text>冷暖 · 冷 ↔ 暖</text><text>{{warmth}}</text></view><slider min="-30" max="30" value="{{warmth}}" data-key="warmth" bindchanging="onControl" bindchange="onControl" activeColor="#78475f" block-size="24" aria-label="实时冷暖色调"/><view class="control-label"><text>明度 · 深 ↔ 浅</text><text>{{brightness}}</text></view><slider min="-30" max="30" value="{{brightness}}" data-key="brightness" bindchanging="onControl" bindchange="onControl" activeColor="#78475f" block-size="24" aria-label="实时色调明度"/></view>
      </block>
      <block wx:if="{{trackingMode === 'face' && category === 'lipstick'}}">
        <view class="shade-list"><button class="shade {{lipShade === 'nude' ? 'is-selected' : ''}}" data-value="nude" bindtap="onColor" aria-pressed="{{lipShade === 'nude'}}"><text class="shade-chip lip-nude"></text><text>裸杏</text></button><button class="shade {{lipShade === 'rose' ? 'is-selected' : ''}}" data-value="rose" bindtap="onColor" aria-pressed="{{lipShade === 'rose'}}"><text class="shade-chip lip-rose"></text><text>玫瑰</text></button><button class="shade {{lipShade === 'berry' ? 'is-selected' : ''}}" data-value="berry" bindtap="onColor" aria-pressed="{{lipShade === 'berry'}}"><text class="shade-chip lip-berry"></text><text>莓果</text></button><button class="shade {{lipShade === 'coral' ? 'is-selected' : ''}}" data-value="coral" bindtap="onColor" aria-pressed="{{lipShade === 'coral'}}"><text class="shade-chip lip-coral"></text><text>珊瑚</text></button><button class="shade {{lipShade === 'red' ? 'is-selected' : ''}}" data-value="red" bindtap="onColor" aria-pressed="{{lipShade === 'red'}}"><text class="shade-chip lip-red"></text><text>绯红</text></button></view>
        <view class="finish-list"><button class="finish {{look.lipFinish === 'satin' ? 'is-selected' : ''}}" data-value="satin" bindtap="onLipFinish" aria-pressed="{{look.lipFinish === 'satin'}}">缎光</button><button class="finish {{look.lipFinish === 'velvet' ? 'is-selected' : ''}}" data-value="velvet" bindtap="onLipFinish" aria-pressed="{{look.lipFinish === 'velvet'}}">柔雾</button></view>
      </block>
      <view wx:if="{{trackingMode === 'face' && category === 'blush'}}" class="shade-list blush-list"><button class="shade {{blushShade === 'rose' ? 'is-selected' : ''}}" data-value="rose" bindtap="onColor" aria-pressed="{{blushShade === 'rose'}}"><text class="shade-chip blush-rose"></text><text>蔷薇</text></button><button class="shade {{blushShade === 'peach' ? 'is-selected' : ''}}" data-value="peach" bindtap="onColor" aria-pressed="{{blushShade === 'peach'}}"><text class="shade-chip blush-peach"></text><text>蜜桃</text></button><button class="shade {{blushShade === 'mauve' ? 'is-selected' : ''}}" data-value="mauve" bindtap="onColor" aria-pressed="{{blushShade === 'mauve'}}"><text class="shade-chip blush-mauve"></text><text>烟粉</text></button></view>
      <view wx:if="{{trackingMode === 'face' && category !== 'foundation'}}" class="strength-row"><text>{{category === 'lipstick' ? '唇色浓度' : '腮红浓度'}}</text><slider value="{{category === 'lipstick' ? look.lipStrength : look.blushStrength}}" bindchanging="onLookStrength" bindchange="onLookStrength" activeColor="#78475f" block-size="24" aria-label="{{category === 'lipstick' ? '唇色浓度' : '腮红浓度'}}"/><text>{{category === 'lipstick' ? look.lipStrength : look.blushStrength}}%</text></view>
      <view wx:if="{{mode === 'split'}}" class="strength-row"><text>对比位置</text><slider value="{{split}}" data-key="split" bindchanging="onControl" bindchange="onControl" activeColor="#78475f" block-size="24" aria-label="原图与妆效分屏位置"/><text>{{split}}%</text></view>
      <button wx:if="{{trackingMode === 'region'}}" class="text-button recalibrate" bindtap="onFreeze">重新圈选试妆区域</button>
    </view>
    <view class="mirror-footer"><text>模拟妆效 · 非商品实测</text><button wx:if="{{cameraEnabled}}" class="text-button" bindtap="stopCamera">关闭相机</button></view>
    <text class="preview-disclaimer">概念色彩，不对应商品色号。{{trackingMode === 'face' ? '人脸试妆需手机微信支持，转头过大或跟踪丢失时会撤去妆效。' : '圈选辅助不判断白癜风。请缓慢移动，保持光线和距离稳定。'}}画面仅在本机处理。</text>
  </view>
</view>
