.mirror-page { max-width: 600px; margin: 0 auto; background: var(--paper); padding-bottom: env(safe-area-inset-bottom); }
.mirror-header { display: flex; align-items: center; gap: 14rpx; min-height: 92rpx; padding: 0 28rpx 0 8rpx; }
.mirror-back { width: 48px; min-height: 48px; padding: 0; background: transparent; color: var(--ink); font: 38px/48px Arial,sans-serif; }
.mirror-wordmark { font: 600 32rpx/1.2 "DIN Alternate",Arial,sans-serif; letter-spacing: 5rpx; flex: 1; }
.mirror-caption { font-size: max(12px,24rpx); color: var(--accent); }
.tracking-tabs { display: flex; gap: 28rpx; padding: 0 28rpx 14rpx; }
.tracking-tab { margin: 0; min-height: 44px; padding: 8rpx 4rpx; background: transparent; color: var(--muted); border-bottom: 2px solid transparent; border-radius: 0; font-size: max(14px,28rpx); }
.tracking-tab.is-selected { color: var(--accent); border-color: var(--accent); font-weight: 600; }
.category-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); border-bottom: 1px solid var(--line); gap: 12rpx; }
.category { min-width: 0; margin: 0; padding: 16rpx 4rpx; background: transparent; color: var(--muted); border-radius: 0; border-bottom: 2px solid transparent; font-size: max(14px,28rpx); line-height: 1.5; }
.category text { display: block; font-size: max(12px,22rpx); font-weight: 400; }
.category.is-selected { color: var(--accent); border-color: var(--accent); font-weight: 600; }
.layer-heading { display: flex; gap: 12rpx; align-items: center; justify-content: space-between; font-size: max(12px,24rpx); }
.layer-heading .text-button { flex: none; width: auto; margin: 0; padding: 0; color: var(--accent); }
.finish-list { display: flex; gap: 16rpx; padding: 14rpx 0; }
.finish { min-height: 44px; min-width: 88px; margin: 0; padding: 8rpx 28rpx; line-height: 1.5; font-size: max(12px,24rpx); background: var(--surface); border: 1px solid var(--line); color: var(--muted); border-radius: 40rpx; }
.finish.is-selected { color: var(--accent); background: var(--accent-soft); border-color: var(--accent); }
.shade-list.blush-list { grid-template-columns: repeat(3,minmax(0,1fr)); }
.lip-nude { background: #a4635b; }.lip-rose { background: #9b3950; }.lip-berry { background: #75294b; }.lip-coral { background: #cc5248; }.lip-red { background: #a7232f; }
.blush-rose { background: #ca6b76; }.blush-peach { background: #d98366; }.blush-mauve { background: #a96987; }
.mirror-viewport { background: var(--surface-soft); position: relative; }
.mirror-page--face .mirror-viewport { position: sticky; top: 0; z-index: 5; }
.live-stage { position: relative; width: 100%; margin: 0 auto; overflow: hidden; background: var(--surface-soft); }
.native-camera, .preview-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
.native-camera { z-index: 0; }
.preview-canvas { z-index: 1; }
.canvas-inactive { left: -10000px; visibility: hidden; pointer-events: none; }
.camera-empty { position: absolute; z-index: 3; inset: 0; background: var(--surface-soft); display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 18rpx; padding: 28rpx; text-align: center; font-size: 24rpx; color: var(--muted); pointer-events: none; }
.mirror-illustration { width: 210rpx; height: 260rpx; flex-shrink: 1; min-height: 60px; }
.camera-empty .empty-title { font-size: 40rpx; color: var(--ink); font-weight: 500; letter-spacing: 3rpx; }
.empty-local { margin-top: 10rpx; font-size: max(12px,22rpx); color: var(--muted); }
.mirror-badges { display: flex; align-items: center; justify-content: space-between; padding: 0 24rpx; background: var(--paper); }
.preview-label { background: var(--paper); color: var(--ink); font: 600 22rpx/1.3 Arial,"Microsoft YaHei",sans-serif; padding: 10rpx 16rpx; letter-spacing: 2rpx; }
.mirror-flip { min-width: 44px; min-height: 44px; padding: 0 16rpx; line-height: 44px; background: rgba(255,255,255,.94); color: var(--ink); font-size: max(12px,24rpx); pointer-events: auto; margin: 0; }
.mirror-comparison { display: flex; gap: 18rpx; justify-content: center; padding: 12rpx 24rpx; background: var(--paper); }
.mirror-tool { min-height: 44px; padding: 0 24rpx; margin: 0; line-height: 44px; background: rgba(255,255,255,.94); color: var(--ink); border: 1px solid transparent; font-size: max(12px,24rpx); }
.mirror-tool { border-radius: 18rpx; }
.mirror-tool.is-active { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
.mirror-tool[disabled] { color: var(--muted); background: var(--surface-soft); }
.split-captions { display: flex; justify-content: space-between; padding: 8rpx 24rpx 0; background: var(--paper); }
.split-captions view { background: rgba(255,255,255,.94); padding: 6rpx 12rpx; font-size: max(12px,22rpx); }
.mirror-dock { padding: 0 28rpx 24rpx; background: var(--paper); border-radius: 28rpx 28rpx 0 0; }
.live-status { display: flex; align-items: flex-start; gap: 12rpx; padding: 18rpx 0; min-height: 2.8em; font-size: max(12px,24rpx); line-height: 1.5; color: var(--muted); }
.live-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--line-strong); flex: none; margin-top: 12rpx; }
.live-dot--active { background: var(--accent); }
.tracking-error { margin: 0 0 16rpx; }
.tracking-recovery { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.tracking-recovery button { flex: 1; min-width: 120px; margin: 0; font-size: max(13px,26rpx); }
.formula-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8rpx; padding: 6rpx; background: var(--accent-soft); border-radius: 20rpx; }
.formula { margin: 0; min-width: 0; min-height: 48px; padding: 12rpx 8rpx; border: 1px solid transparent; border-radius: 16rpx; background: transparent; color: var(--muted); font-size: calc(26rpx + .5rem - 8px); line-height: 1.5; transition: background-color 150ms ease,color 150ms ease; }
.formula.is-selected { background: var(--surface); color: var(--accent); font-weight: 600; }
.shade-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: max(12px,24rpx); }
.shade-heading .fine-toggle { color: var(--accent); width: auto; margin: 0; padding: 0 0 0 12rpx; min-height: 44px; }
.shade-list { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 4rpx; }
.shade { min-width: 44px; min-height: 68px; padding: 8rpx 0; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 9rpx; background: transparent; color: var(--muted); line-height: 1.4; font-size: max(12px,22rpx); border: 1px solid transparent; border-radius: 4rpx; }
.shade.is-selected { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
.shade-chip { display: block; width: 42rpx; height: 42rpx; border-radius: 50%; border: 1px solid rgba(21,21,21,.15); }
.shade-cool { background: #ba9489; }.shade-match { background: #ba9680; }.shade-warm { background: #c59b78; }.shade-lighter { background: #d6b6a0; }.shade-deeper { background: #94715b; }
.strength-row { display: flex; align-items: center; gap: 8rpx; font-size: max(12px,24rpx); min-height: 50px; }
.strength-row slider { flex: 1; min-width: 0; margin: 16rpx; }.strength-row text:last-child { min-width: 56rpx; text-align: right; font-variant-numeric: tabular-nums; }
.fine-panel { padding: 20rpx; background: var(--surface-soft); border-radius: 20rpx; }.control-label { display: flex; justify-content: space-between; font-size: max(12px,24rpx); }
.calibration-steps { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; font-size: 26rpx; }.calibration-steps>text { padding: 16rpx; background: var(--surface-soft); }.step-current { color: var(--accent); font-weight: 600; }
.dock-hint { display: block; margin-top: 18rpx; color: var(--muted); font-size: max(12px,24rpx); line-height: 1.6; }
.recalibrate { margin: 0; }.mirror-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx; color: var(--muted); font-size: max(12px,22rpx); min-height: 44px; }
.mirror-footer .text-button { margin: 0; width: auto; padding: 0 10rpx; }
.preview-disclaimer { display: block; color: var(--muted); font-size: max(12px,22rpx); line-height: 1.6; padding-top: 6rpx; }
@media (prefers-reduced-motion: reduce) { .formula { transition: none; } }
