.result-title,
.result-lead,
.confirmed-name,
.confirmed-note,
.confirmed-value,
.section-heading,
.candidate-rank,
.candidate-name,
.candidate-shade,
.candidate-reason,
.candidate-source,
.empty-result__label,
.empty-result__title,
.empty-result__copy,
.limits__title,
.limits text,
.disclaimer,
.commerce-summary__label,
.commerce-summary__shade {
  display: block;
}

.result-title {
  font-size: calc(52rpx + 0.5rem - 8px);
}

.result-lead {
  max-width: 620rpx;
  color: var(--ink-soft);
  font-size: calc(28rpx + 0.5rem - 8px);
}

.confirmed-samples {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 72rpx minmax(0, 1fr);
  align-items: stretch;
  margin-top: 30rpx;
  gap: 8rpx;
}

.confirmed-sample {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  flex-direction: column;
  padding: 28rpx 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
  gap: 20rpx;
}

.confirmed-bridge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.confirmed-swatch {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(23, 23, 23, 0.2);
  border-radius: 50%;
  background: #efefec;
  color: var(--muted);
  font-weight: 700;
}

.confirmed-name {
  font-size: calc(23rpx + 0.5rem - 8px);
  font-weight: 700;
  line-height: 1.4;
}

.confirmed-copy {
  min-width: 0;
  flex: 1;
}

.confirmed-note {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: max(12px, calc(24rpx + 0.5rem - 8px));
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.confirmed-value {
  margin-top: 2rpx;
  color: var(--ink-soft);
  font-family: Consolas, monospace;
  font-size: max(12px, calc(24rpx + 0.5rem - 8px));
  font-weight: 700;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.sample-photo-section {
  margin-top: 20rpx;
  border-top: 2rpx solid var(--line);
  border-bottom: 2rpx solid var(--line);
}

.photo-toggle {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  min-height: max(88rpx, 44px);
  align-items: center;
  justify-content: space-between;
  padding: 0;
  background: transparent;
  color: var(--ink);
  gap: 16rpx;
  font-size: calc(25rpx + 0.5rem - 8px);
  font-weight: 700;
  line-height: 1.4;
  white-space: normal;
  transition: background-color 140ms ease, transform 140ms ease;
}

.sample-photo {
  display: block;
  width: 100%;
  height: auto;
  background: #222220;
}

.sample-photo-frame {
  position: relative;
  margin: 0 auto 24rpx;
}

.result-marker {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 2px #17181a;
  transform: translate(-50%, -50%);
}

.result-marker text {
  padding: 0 4px;
  border-radius: 3px;
  background: #17181a;
  color: #ffffff;
  font-size: calc(24rpx + 0.5rem - 8px);
  font-weight: 700;
}

.result-marker--cover { border-style: dashed; }
.finish-button { margin-top: 24rpx; }
.cleared-result .primary-button { margin-top: 32rpx; }

.candidate-section,
.empty-result {
  margin-top: 34rpx;
}

.section-heading {
  margin-bottom: 14rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: calc(34rpx + 0.5rem - 8px);
  font-weight: 700;
}

.candidate-item {
  position: relative;
  display: grid;
  min-height: 224rpx;
  grid-template-columns: 156rpx minmax(0, 1fr) 104rpx;
  align-items: center;
  margin-top: 12rpx;
  padding: 18rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: 8rpx;
  background: var(--surface);
  gap: 18rpx;
  transition: background-color 140ms ease, border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;
}

.candidate-item--selected {
  border-color: var(--ink);
  box-shadow: inset 6rpx 0 0 var(--accent);
}

.candidate-item--pressed {
  background: #f0f0ee;
  transform: translateY(2rpx);
}

.product-image {
  width: 156rpx;
  height: 188rpx;
  background: #f1f1ee;
}

.candidate-copy {
  min-width: 0;
}

.candidate-rank {
  color: var(--accent-pressed);
  font-size: calc(21rpx + 0.5rem - 8px);
  font-weight: 700;
}

.candidate-name {
  margin-top: 8rpx;
  font-size: calc(27rpx + 0.5rem - 8px);
  font-weight: 700;
  line-height: 1.35;
}

.candidate-shade {
  margin-top: 8rpx;
  font-size: calc(25rpx + 0.5rem - 8px);
  overflow-wrap: anywhere;
}

.candidate-reason,
.candidate-source {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: calc(21rpx + 0.5rem - 8px);
  line-height: 1.45;
}

.candidate-check {
  color: var(--success);
  font-size: calc(20rpx + 0.5rem - 8px);
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.empty-result {
  padding: 28rpx;
  border-left: 3rpx solid var(--gold);
  background: var(--surface-soft);
}

.empty-result__label {
  color: var(--gold-ink);
  font-size: calc(22rpx + 0.5rem - 8px);
  font-weight: 700;
}

.empty-result__title {
  margin-top: 12rpx;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: calc(34rpx + 0.5rem - 8px);
  font-weight: 700;
  line-height: 1.4;
}

.empty-result__copy {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: calc(25rpx + 0.5rem - 8px);
  line-height: 1.7;
}

.limits {
  margin-top: 28rpx;
  padding: 22rpx 0;
  border-top: 2rpx solid var(--line);
  border-bottom: 2rpx solid var(--line);
  color: var(--muted);
  font-size: calc(23rpx + 0.5rem - 8px);
  line-height: 1.65;
}

.limits__title {
  margin-bottom: 6rpx;
  color: var(--ink);
  font-weight: 700;
}

.disclaimer {
  margin-top: 22rpx;
  color: var(--muted);
  font-size: calc(22rpx + 0.5rem - 8px);
  line-height: 1.65;
}

.result-secondary-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  margin-top: 26rpx;
  gap: 12rpx;
}

.commerce-dock,
.commerce-dock-spacer {
  display: grid;
  width: 100%;
  grid-template-columns: minmax(0, 1fr) minmax(240rpx, 300rpx);
  align-items: center;
  gap: 20rpx;
}

.commerce-dock-spacer {
  margin-top: 28rpx;
  padding: 22rpx 0 calc(22rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid transparent;
  visibility: hidden;
}

.commerce-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  max-width: 600px;
  margin: 0 auto;
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--line-strong);
  background: var(--surface);
  box-shadow: 0 -10rpx 30rpx rgba(23, 24, 26, 0.1);
}

.commerce-summary {
  min-width: 0;
}

.commerce-summary__label {
  color: var(--muted);
  font-size: calc(20rpx + 0.5rem - 8px);
}

.commerce-summary__shade {
  margin-top: 4rpx;
  font-size: calc(25rpx + 0.5rem - 8px);
  font-weight: 700;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.commerce-button {
  min-height: 88rpx;
  min-height: max(88rpx, 44px);
  font-size: calc(27rpx + 0.5rem - 8px);
}

.result-page .step-kicker {
  font-size: calc(22rpx + 0.5rem - 8px);
}

.result-page .primary-button,
.result-page .secondary-button,
.result-page .text-button,
.commerce-dock .primary-button {
  height: auto;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  line-height: 1.35;
  white-space: normal;
}

.result-page .primary-button,
.result-page .secondary-button,
.commerce-dock .primary-button {
  font-size: calc(28rpx + 0.5rem - 8px);
}

.result-page .text-button {
  font-size: calc(26rpx + 0.5rem - 8px);
}

@media (max-width: 360px) {
  .result-secondary-actions {
    grid-template-columns: 1fr;
  }

  .commerce-dock {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .candidate-item {
    grid-template-columns: 120rpx minmax(0, 1fr);
  }

  .product-image {
    width: 120rpx;
    height: 150rpx;
  }

  .candidate-check {
    grid-column: 2;
    text-align: left;
  }

}
